# MIT KDC for the demo's Kerberos destination. Same as
# bnaas-poc/krb-spike/rig/Dockerfile.kdc; only the file layout moved.
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        krb5-kdc \
        krb5-admin-server \
        krb5-user \
    && rm -rf /var/lib/apt/lists/*

COPY krb5.conf /etc/krb5.conf
COPY kdc.conf /etc/krb5kdc/kdc.conf
COPY --chmod=755 kdc-entrypoint.sh /kdc-entrypoint.sh

ENTRYPOINT ["/kdc-entrypoint.sh"]
