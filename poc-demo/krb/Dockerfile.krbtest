# Linux runtime for the backbeat kerberos functional suite (demo act 07).
#
# The suite needs MIT krb5 for the GSSAPI binding and kinit, and build tools
# for the native modules. This is the image act 07 runs the branch's own
# tests/functional/deliverypool/kerberos.js inside, on the krb profile's
# network namespace. Built by bin/krb-test-image.sh at `yarn demo:up:krb`
# time, so it never runs during a demo. Tagged backbeat-krbtest:spike.
FROM node:22-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
      krb5-user libkrb5-dev libgssapi-krb5-2 libsasl2-dev libsasl2-2 \
      libsasl2-modules-gssapi-mit build-essential python3 git jq procps \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /usr/src/app
# scubaclient's prepare script runs tsc, so typescript has to be global.
RUN npm install -g typescript@5 >/dev/null 2>&1 && tsc --version
