# BNaaS demo stack, single source of truth for ports.
#
# Edit the knobs block only. Everything below the "derived" marker is
# rewritten from PORT_OFFSET by bin/_common.sh on every script run, so
# hand edits there are overwritten.
#
# PORT_OFFSET=0 gives the standard ports: kafka 9092, zookeeper 2181,
# redis 6379, mongo 27117, prometheus 9090, grafana 3000, kafka-ui 8085.
# It is 1000 while the older rig (compose project `ft`) still owns the
# standard ports on this machine. Set it to 0 once that rig is retired.

# ---- knobs ----
COMPOSE_PROJECT_NAME=bnaasdemo
PORT_OFFSET=1000

# paths, read by the process scripts and the demo test suite, and
# overridable from the environment. This material lives inside the backbeat
# repository, so the scripts resolve the repository from their own location
# and BACKBEAT_DIR does not need setting. CLOUDSERVER_DIR is set further
# down; it may be relative, and is resolved against the repository, then
# against this directory.
# node 22: native modules break on 24. Only set this when the node on your
# PATH is not 22; otherwise the suite and the scripts use the node already on
# PATH (which is the one mocha runs on), so a fresh machine needs no edit here.
#NODE_BIN=$HOME/.nvm/versions/node/v22.22.3/bin

# images. Only KAFKA_UI_IMAGE and KAFKA_EXPORTER_IMAGE need a pull.
KAFKA_IMAGE=poc-ft-kafka:latest
ZOOKEEPER_IMAGE=zookeeper:3.9.4
REDIS_IMAGE=redis:7-alpine
MONGO_IMAGE=ci-mongodb:latest
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
GRAFANA_IMAGE=grafana/grafana:11.3.0
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2
KAFKA_EXPORTER_IMAGE=danielqsj/kafka-exporter:v1.7.0
# amd64 only, so it runs under emulation on Apple silicon
ZOONAV_IMAGE=elkozmon/zoonavigator:1.1.2
SOCAT_IMAGE=alpine/socat:1.8.0.0
# amd64 only as well: no arm64 manifest is published for the 9.3 tags
CLOUDSERVER_IMAGE=ghcr.io/scality/cloudserver:9.3.20
# Only used by the `cloudserver-build` profile, the slower fallback, and by
# bin/cloudserver.sh. Relative, resolved against the repository root, so the
# default is a cloudserver checkout beside this one.
CLOUDSERVER_DIR=../cloudserver
# krb profile. Built from demo/krb/ on a fresh machine. On this machine the
# equivalent images already exist as bnaaskrb-kdc:latest and
# bnaaskrb-kafka:latest and can be named here to skip the build.
KRB_KDC_IMAGE=bnaasdemo-kdc:latest
KRB_KAFKA_IMAGE=bnaasdemo-krb-kafka:latest

# ZooKeeper paths the demo shows on screen. They must match the backbeat
# config the workers and the populator are started with.
ZK_WORKGROUPS_PATH=/bnaas-demo/delivery-workgroups
ZK_POPULATOR_PATH=/bnaas-demo/queue-populator
# The pool's base consumer group id. A workgroup's real group is
# <base>-<workgroupId>-gen<generation>, which is how a generation cutover
# shows up as one group's lag falling to zero while another's starts.
DELIVERY_GROUP_BASE=bucket-notification-delivery-group

# topics created by bin/topics-create.sh. The decided model has ONE topic
# the pipeline consumes, LEGACY_TOPIC, which the populator already writes to
# and the workers read. The destination-keyed delivery topic the POC first
# built is retired: it is not created, not named here, and not on the
# broker. bin/lib.sh still carries a default for it so the retired
# DEMO_SOURCE=delivery path can name a topic, but nothing creates it.
LEGACY_TOPIC=backbeat-bucket-notification
LEGACY_TOPIC_PARTITIONS=4
FAILED_TOPIC=backbeat-bucket-notification-failed
CUSTOMER_TOPICS="customer-topic-1 customer-topic-2 customer-topic-3"
CUSTOMER_TOPIC_PARTITIONS=1

# Delivery worker probe ports on the HOST, scraped by prometheus as
# host.docker.internal:<port>. Informational here: prometheus.yml carries
# both the offset-0 range (8920-8930) and the offset-1000 range
# (9920-9930) as explicit targets, because prometheus does not expand
# environment variables in its config file. The process scripts derive
# their own base as 8920 + PORT_OFFSET, so the two agree at either offset.
DELIVERY_PROBE_PORT_BASE=8920
DELIVERY_PROBE_PORT_COUNT=11
# ---- derived (regenerated by bin/_common.sh, do not edit) ----
ZK_PORT=3181
KAFKA_PORT=10092
REDIS_PORT=7379
MONGO_PORT=28117
PROMETHEUS_PORT=10090
GRAFANA_PORT=4000
KAFKA_UI_PORT=9085
KAFKA_EXPORTER_PORT=10308
ZOONAV_PORT=10000
CLOUDSERVER_PORT=9010
KRB_KDC_PORT=2088
KRB_BROKER_PORT=20095
KRB_VERIFY_PORT=20096
# container-internal only, never published, never offset
KAFKA_INTERNAL_PORT=29092
