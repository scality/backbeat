{
  "uid": "bnaas-delivery-pool",
  "title": "BNaaS delivery pool",
  "description": "Bucket notifications as a service: the delivery pool, its destinations, and the consumer-group lag that makes a legacy-to-pool cutover visible. Prometheus only.",
  "tags": [
    "bnaas",
    "notification",
    "backbeat"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "style": "dark",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "delivery_group_base",
        "label": "delivery group base",
        "type": "textbox",
        "query": "bucket-notification-delivery-group",
        "current": {
          "selected": false,
          "text": "bucket-notification-delivery-group",
          "value": "bucket-notification-delivery-group"
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "delivery_topic",
        "label": "delivery topic",
        "type": "textbox",
        "query": "bucket-notification-delivery",
        "current": {
          "selected": false,
          "text": "bucket-notification-delivery",
          "value": "bucket-notification-delivery"
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Notifications delivered per second, by destination",
      "description": "rate() over the delivery workers' delivered counter, summed across every worker in the pool and split by the destination id the record was addressed to. One line per customer destination.",
      "datasource": {
        "type": "prometheus",
        "uid": "bnaas-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bnaas-prom"
          },
          "editorMode": "code",
          "expr": "sum by (target) (rate(s3_notification_delivery_worker_delivered_total[1m]))",
          "legendFormat": "{{target}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Drops per second, by reason",
      "description": "Records the pool committed without delivering. reason is one of delivery_timeout (the destination did not ack inside deliveryTimeoutMs), delivery_error, producer_error (could not even open a producer), unknown_destination (no destination configured for the record) or parse_error. A dead destination shows up here rather than as a stall.",
      "datasource": {
        "type": "prometheus",
        "uid": "bnaas-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "axisPlacement": "auto",
