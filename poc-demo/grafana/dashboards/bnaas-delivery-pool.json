    {
      "id": 3,
      "type": "timeseries",
      "title": "Delivery delay, p50 and p99",
      "description": "Time between the send and its delivery report, from the worker's histogram. Buckets top out at 30s, so a destination that hangs shows as p99 pinned at the last bucket and then as a delivery_timeout drop.",
      "datasource": {
        "type": "prometheus",
        "uid": "bnaas-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bnaas-prom"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(s3_notification_delivery_worker_delivery_delay_seconds_bucket[5m])))",
          "legendFormat": "p50 all destinations",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bnaas-prom"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(s3_notification_delivery_worker_delivery_delay_seconds_bucket[5m])))",
          "legendFormat": "p99 all destinations",
          "range": true,
          "instant": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bnaas-prom"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, target) (rate(s3_notification_delivery_worker_delivery_delay_seconds_bucket[5m])))",
          "legendFormat": "p99 {{target}}",
          "range": true,
          "instant": false,
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Consumer group lag, by group and topic",
      "description": "From kafka-exporter, so it covers groups that expose no metrics of their own. This is the only observability the legacy per-destination processor has: it has no delivery counter unless extensions.notification.probeServer is configured, which S3C does not render.",
      "datasource": {
        "type": "prometheus",
        "uid": "bnaas-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": null,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bnaas-prom"
          },
          "editorMode": "code",
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag)",
          "legendFormat": "{{consumergroup}}  <-  {{topic}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cutover: legacy groups versus the delivery pool group",
      "description": "The two sides of a migration on one axis. Both must reach and hold zero before the other side is stopped: cutting over before lag 0 costs ordering, and rolling back before lag 0 strands records on the delivery topic. Lag alone is not enough, a wedged consumer holds its partitions with a lag that simply stops falling, so read this next to the delivered rate above.",
      "datasource": {
        "type": "prometheus",
        "uid": "bnaas-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": null,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bnaas-prom"
          },
          "editorMode": "code",
          "expr": "sum(kafka_consumergroup_lag{consumergroup=~\".*notification-group.*\"})",
          "legendFormat": "legacy per-destination groups",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bnaas-prom"
          },
          "editorMode": "code",
          "expr": "sum(kafka_consumergroup_lag{consumergroup=~\".*delivery.*\"})",
          "legendFormat": "delivery pool group",
          "range": true,
          "instant": false,
          "refId": "B"
        }
      ]
    },
