              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bnaas-prom"
          },
          "editorMode": "code",
          "expr": "sum by (reason) (rate(s3_notification_delivery_worker_dropped_total[1m]))",
          "legendFormat": "{{reason}}",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bnaas-prom"
          },
          "editorMode": "code",
          "expr": "sum by (target) (rate(s3_notification_delivery_worker_dropped_total[1m]))",
          "legendFormat": "target {{target}}",
          "range": true,
          "instant": false,
          "refId": "B"
        }
      ]
